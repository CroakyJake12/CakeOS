[Unit]
Description=Haven local inference broker
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/haven/inference/broker.py
Restart=on-failure
RestartSec=2s
UMask=0077
RuntimeDirectory=haven
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=%h/.local/share/haven/models
ReadWritePaths=%t/haven
Environment=HAVEN_INFERENCE_SOCKET=%t/haven/inference.sock
Environment=HAVEN_LLAMA_WORKER_SOCKET=%t/haven/llamacpp-worker.sock
Environment=HAVEN_LLAMA_SERVER=/usr/lib/haven/llama.cpp/llama-server

[Install]
WantedBy=default.target
